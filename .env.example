# Supabase project credentials (find these in Supabase Dashboard > Project Settings > API)
# Replace these with your project's values before running the app.
# IMPORTANT: Never commit service role keys or OAuth client secrets to source control.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# For server-side operations (Edge Functions) set the following as Supabase secrets
# via the Supabase CLI, DO NOT add them here:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=https://yourapp.com/
